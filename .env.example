# Environment Configuration Example
# Copy to .env and adjust local settings

# Camera
CAMERA_INDEX=0
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
CAMERA_FPS=30
CAMERA_SIMULATION_MODE=auto  # auto, force, disabled

# Inference
MODEL_PATH=models/best.pt
CONFIDENCE_THRESHOLD=0.40
IOU_THRESHOLD=0.50
INFERENCE_DEVICE=cpu

# GPIO & Actuators
ACTUATOR_PIN=17
ACTUATOR_SIMULATION_MODE=true

# I2C & Sensors
I2C_BUS=1
MPU6050_ADDRESS=0x68
SENSOR_SIMULATION_MODE=true

# MQTT Broker
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=8883
MQTT_TLS_ENABLED=true
MQTT_USER=edge_device
MQTT_PASSWORD=edge_secure_password
MQTT_TOPIC_DETECTION=factory/station1/detections
MQTT_TOPIC_ANOMALY=factory/station1/telemetry

# PLC / Modbus
PLC_HOST=127.0.0.1
PLC_PORT=5020
PLC_HOLDING_REGISTER=100
PLC_SIMULATION_MODE=true

# Dashboard
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=5000
